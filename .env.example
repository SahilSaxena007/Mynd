# Copy to .env and fill in. NEVER commit .env.

# --- Database (Railway Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/vault

# --- Access (single-user gate) ---
SECRET_TOKEN=change-me-to-a-long-random-string

# --- Model provider ---
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# model IDs used per job (swappable; benchmark cheaper options later)
ORGANIZE_MODEL=claude-haiku-4-5
# ROUTE_MODEL=claude-haiku-4-5
ROUTE_THINKING_BUDGET=2048
ANSWER_MODEL=claude-sonnet-5
GRADER_MODEL=claude-haiku-4-5

# --- Spend guard (code-level circuit breakers; enforced in lib/model) ---
# These are IN ADDITION to the monthly spend cap you set in the Anthropic console.
MAX_TOKENS_PER_CALL=16000
MAX_CALLS_PER_RUN=50
DAILY_CALL_CAP=500

# --- Organize job ---
USER_TIMEZONE=Europe/London
# Informational only: set the actual UTC schedule on the Railway cron service.
ORGANIZE_CRON=0 7,19 * * *      # 08:00/20:00 BST; 07:00/19:00 in winter
INBOX_AUTORUN_THRESHOLD=25       # auto-run if this many captures are pending
